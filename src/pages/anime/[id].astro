---
import Layout from '../../layouts/Layout.astro';
import animeData from '../../data/anime.json';
import { getStreamingServiceName, getStreamingIcon } from '../../utils/streamingServices';

// Generate static paths for all anime pages
export function getStaticPaths() {
  const animeArray = Array.isArray(animeData) ? animeData : (typeof animeData === 'object' && animeData.anime ? animeData.anime : Object.values(animeData || {}));
  
  return animeArray.map((anime: any) => ({
    params: { id: String(anime.id || anime.anilist_id) },
    props: { anime }
  }));
}

// Get the anime from props
const { anime } = Astro.props;
---

<Layout title={`${anime.title?.english || anime.title?.romaji || 'Anime'} - AnimeExplorer`}>
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <!-- Header with Navigation -->
      <div class="mb-8 flex items-center gap-4">
        <a href="/" class="text-blue-400 hover:text-blue-300 transition">← Voltar</a>
        <a href="/releases" class="text-blue-400 hover:text-blue-300 transition">Lançamentos</a>
      </div>

      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Sidebar - Cover and Stats -->
        <div class="lg:col-span-1">
          <div class="sticky top-4 space-y-6">
            <!-- Cover Image -->
            {anime.coverImage && (
              <div class="rounded-lg overflow-hidden shadow-xl">
                <img 
                  src={anime.coverImage} 
                  alt={anime.title?.english || anime.title?.romaji}
                  class="w-full h-auto object-cover"
                />
              </div>
            )}

            <!-- Quick Stats -->
            <div class="bg-slate-800 rounded-lg p-6 border border-slate-700 space-y-4">
              {anime.status && (
                <div>
                  <p class="text-xs text-slate-400 uppercase">Status</p>
                  <p class="text-lg font-semibold text-white">
                    {anime.status === 'RELEASING' && '🎬 Em Lançamento'}
                    {anime.status === 'FINISHED' && '✅ Finalizado'}
                    {anime.status === 'NOT_YET_RELEASED' && '⏳ Não Lançado'}
                  </p>
                </div>
              )}

              {anime.episodes && (
                <div>
                  <p class="text-xs text-slate-400 uppercase">Episódios</p>
                  <p class="text-lg font-semibold text-white">{anime.episodes}</p>
                </div>
              )}

              {anime.averageScore && (
                <div>
                  <p class="text-xs text-slate-400 uppercase">Avaliação</p>
                  <p class="text-lg font-semibold text-yellow-400">★ {(anime.averageScore / 10).toFixed(1)}/10</p>
                </div>
              )}

              {anime.season && anime.seasonYear && (
                <div>
                  <p class="text-xs text-slate-400 uppercase">Temporada</p>
                  <p class="text-lg font-semibold text-white">{anime.season} {anime.seasonYear}</p>
                </div>
              )}
            </div>

            <!-- Streaming Links -->
            {anime.streamingLinks && anime.streamingLinks.length > 0 && (
              <div class="bg-green-900/30 border border-green-500/50 rounded-lg p-6">
                <h3 class="font-semibold text-green-300 mb-3">📺 Assista Legalmente</h3>
                <div class="space-y-2">
                  {anime.streamingLinks.map((link: any) => (
                    <a 
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-3 rounded text-center text-sm transition"
                    >
                      {getStreamingIcon(link.url)} {getStreamingServiceName(link.url)}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Main Content - Description and Details -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Title -->
          <div>
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-2">
              {anime.title?.english || anime.title?.romaji || 'Unknown'}
            </h1>
            {anime.title?.romaji && anime.title?.romaji !== anime.title?.english && (
              <p class="text-lg text-slate-300">{anime.title.romaji}</p>
            )}
          </div>

          <!-- Genres -->
          {anime.genres && anime.genres.length > 0 && (
            <div>
              <p class="text-sm text-slate-400 uppercase mb-2">Gêneros</p>
              <div class="flex flex-wrap gap-2">
                {anime.genres.map((genre: string) => (
                  <span class="px-3 py-1 bg-blue-600/30 border border-blue-500/50 text-blue-200 rounded-full text-sm">
                    {genre}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Description -->
          {anime.description && (
            <div>
              <p class="text-sm text-slate-400 uppercase mb-2">Sinopse</p>
              <p class="text-slate-300 leading-relaxed">
                {anime.description}
              </p>
            </div>
          )}

          <!-- Studios -->
          {anime.studios && anime.studios.length > 0 && (
            <div>
              <p class="text-sm text-slate-400 uppercase mb-2">Estúdios</p>
              <div class="flex flex-wrap gap-2">
                {anime.studios.map((studio: string) => (
                  <span class="text-slate-300">
                    {studio}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Trailer -->
          {anime.trailer && (
            <div>
              <p class="text-sm text-slate-400 uppercase mb-3">Trailer</p>
              <iframe 
                width="100%" 
                height="400" 
                src={`https://www.youtube.com/embed/${anime.trailer}`}
                title="Anime Trailer"
                class="rounded-lg"
                allowfullscreen
              ></iframe>
            </div>
          )}
        </div>
      </div>

      <!-- Footer Info -->
      <div class="mt-12 pt-8 border-t border-slate-700">
        <p class="text-sm text-slate-500">
          Dados fornecidos por <a href="https://anilist.co" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300">AniList</a>
        </p>
      </div>
    </div>
  </div>
</Layout>
