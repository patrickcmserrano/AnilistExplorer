---
const { anime } = Astro.props;
---

<a href={`/anime/${anime.id}`} class="group block">
  <article class="relative aspect-[2/3] rounded-lg overflow-hidden shadow-lg">
    <img src={anime.cover_image} alt={anime.base_title} class="w-full h-full object-cover group-hover:scale-105 transition" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent">
      <div class="absolute bottom-0 p-3">
        <h3 class="text-white font-semibold text-sm line-clamp-2">{anime.base_title}</h3>
        <p class="text-gray-300 text-xs mt-1">{anime.count || 0} releases</p>
      </div>
    </div>
  </article>
</a>
