---
interface Props {
  anime: any;
}

const { anime } = Astro.props;
---

<!-- Sidebar Left Column -->
<div class="lg:col-span-1">
  <div class="sticky top-6">
    <img 
      src={anime.cover_image} 
      alt={anime.base_title}
      class="w-full rounded-2xl shadow-2xl"
    />
    
    <div class="mt-6 space-y-3">
      {anime.average_score && (
        <div class="flex items-center justify-between p-3 bg-gradient-to-r from-yellow-500/10 to-orange-500/10 rounded-lg border border-yellow-500/30">
          <span class="text-gray-400 text-sm">Avaliação</span>
          <span class="text-yellow-400 font-bold text-lg">★ {anime.average_score}%</span>
        </div>
      )}
      
      {(anime.seeders !== undefined || anime.leechers !== undefined) && (
        <div class="p-3 bg-gray-800/50 rounded-lg border border-gray-700/50 space-y-2">
          {anime.seeders !== undefined && (
            <div class="flex items-center justify-between">
              <span class="text-gray-400 text-sm">Seeders</span>
              <span class="text-green-400 font-semibold">🌱 {anime.seeders}</span>
            </div>
          )}
          {anime.leechers !== undefined && (
            <div class="flex items-center justify-between">
              <span class="text-gray-400 text-sm">Leechers</span>
              <span class="text-blue-400 font-semibold">📥 {anime.leechers}</span>
            </div>
          )}
        </div>
      )}

      <div class="flex items-center justify-between p-3 bg-gray-800/50 rounded-lg border border-gray-700/50">
        <span class="text-gray-400 text-sm">Publicadores</span>
        <span class="text-purple-400 font-semibold">{Object.keys(anime.releases || {}).length}</span>
      </div>

      {anime.popularity && (
        <div class="flex items-center justify-between p-3 bg-gray-800/50 rounded-lg border border-gray-700/50">
          <span class="text-gray-400 text-sm">Popularidade</span>
          <span class="text-pink-400 font-semibold">💜 {anime.popularity.toLocaleString()}</span>
        </div>
      )}
    </div>
  </div>
</div>
